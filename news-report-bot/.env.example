# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤, 값을 채워 넣으세요.
#   cp .env.example .env       (Windows PowerShell: copy .env.example .env)
#
# .env 파일은 절대 공유하지 마세요. 메신저·메일·깃허브에 올리면 키가 유출됩니다.

# ── 모니터링 설정 ──────────────────────────────────────────
# 쉼표로 구분. 팀에 맞게 바꾸세요.
KEYWORDS=데이터센터,건설 수주,플랜트 입찰

# 직접 지정할 RSS 주소 (비워도 됩니다. 비우면 키워드로 구글뉴스 RSS를 자동 생성)
# 예) 연합뉴스 경제: https://www.yna.co.kr/rss/economy.xml
RSS_FEEDS=

# 공시를 지켜볼 회사명. 비우면 해당 기간 전체 공시를 봅니다.
DART_WATCH=

DAYS_BACK=1
MAX_ITEMS=40

# ── API 키 3종 ────────────────────────────────────────────
# DART 공시  → https://opendart.fss.or.kr  회원가입 후 인증키 신청 (무료)
DART_API_KEY=

# 네이버 검색 → https://developers.naver.com  애플리케이션 등록 후 발급 (무료)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Claude API → https://console.anthropic.com  API Keys 메뉴에서 발급 (유료, 소액)
ANTHROPIC_API_KEY=

# ── 메일 발송 (아웃룩) ────────────────────────────────────
# 보내는 사람 = 내 아웃룩 주소. MAIL_TO 를 비우면 여기로 온다.
OUTLOOK_ADDRESS=your-id@company.com

# 발송 방식: graph | smtp | auto
#   graph = Microsoft Graph API. 회사 아웃룩(Microsoft 365)은 이 방식만 된다. (권장)
#   smtp  = 아이디/비밀번호로 보내는 옛 방식. 막아둔 회사가 대부분이다.
#   auto  = MS_CLIENT_ID 가 채워져 있으면 graph, 아니면 smtp
MAIL_PROVIDER=auto

# ── graph 방식일 때 ───────────────────────────────────────
# Azure 포털(https://portal.azure.com) → Microsoft Entra ID → 앱 등록 →
#   새 등록 → 리디렉션 URI 없음 → [인증] 탭에서 "퍼블릭 클라이언트 흐름 허용"을 예로
#   → [API 권한] 에서 Microsoft Graph > 위임된 권한 > Mail.Send 추가
# 여기 넣는 것은 앱 ID(공개값)뿐이다. 비밀번호는 넣지 않는다.
MS_CLIENT_ID=

# 회사 테넌트 ID. 앱 등록 화면의 "디렉터리(테넌트) ID" 를 그대로 붙여넣는다.
# 개인 outlook.com 계정으로도 로그인하려면 common 으로 둔다.
MS_TENANT_ID=common

# ── smtp 방식일 때만 ──────────────────────────────────────
# 개인 outlook.com 계정이거나, 사내에서 SMTP 인증을 아직 허용하는 경우에만.
# 회사 계정에서 535 오류가 나면 막힌 것이므로 graph 방식으로 넘어간다.
OUTLOOK_PASSWORD=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587

# 받는 사람 (쉼표로 여러 명). 비우면 본인에게 보냅니다.
MAIL_TO=
