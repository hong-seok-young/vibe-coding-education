# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤, 값을 채워 넣으세요.
#   cp .env.example .env       (Windows PowerShell: copy .env.example .env)
#
# .env 파일은 절대 공유하지 마세요. 메신저·메일·깃허브에 올리면 키가 유출됩니다.

# ── 모니터링 설정 ──────────────────────────────────────────
# 쉼표로 구분. 팀에 맞게 바꾸세요.
KEYWORDS=데이터센터,건설 수주,플랜트 입찰

# 직접 지정할 RSS 주소 (비워도 됩니다. 비우면 키워드로 구글뉴스 RSS를 자동 생성)
# 여러 개면 쉼표로 구분. 연합뉴스 경제: https://www.yna.co.kr/rss/economy.xml
# (한국경제·매일경제 등도 각 사이트에서 RSS 주소를 검색해 추가하면 된다 — 언론사가
#  주소를 바꾸기도 하니, 위 주소도 안 될 경우 최신 주소를 다시 확인할 것)
RSS_FEEDS=

# 공시를 지켜볼 회사명. 비우면 해당 기간 전체 공시를 봅니다.
DART_WATCH=

DAYS_BACK=1
MAX_ITEMS=40

# ── API 키 2종 ────────────────────────────────────────────
# DART 공시  → https://opendart.fss.or.kr  회원가입 후 인증키 신청 (무료)
DART_API_KEY=

# 뉴스 검색 → https://newsapi.org  가입 후 API 키 발급 (무료, 개발/테스트용 제한 있음)
NEWSAPI_KEY=

# ── 메일 발송 ─────────────────────────────────────────────
# 이 봇은 메일 서버(SMTP)에 직접 붙지 않고, 내 PC에 로그인되어 있는
# 아웃룩(클래식 데스크톱 앱)을 원격 조작해서 보냅니다. 그래서 비밀번호를
# 여기 적을 필요가 없습니다 — 실행 전에 아웃룩에 로그인만 되어 있으면 됩니다.
# (사내망이 외부 SMTP를 막아둔 경우가 많아 이 방식을 씁니다. 윈도우 전용)

# 받는 사람 (쉼표로 여러 명). 비우면 발송을 건너뜁니다 — 반드시 채우세요.
MAIL_TO=me@company.com
